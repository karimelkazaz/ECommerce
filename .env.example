# Copy to .env and fill in real values. .env is ignored by git and loaded by
# compose (variable interpolation) and by the ecommerce-api service (env_file).

# ---- SQL Server ----
# Must be strong per SQL Server rules (>=8 chars incl. uppercase, lowercase,
# digit, symbol) or the container exits immediately.
SA_PASSWORD=Change_Me_2026!Strong

# ---- JWT ----
# >= 32 characters. Required; startup fails without it.
JWT__SECRETKEY=replace-with-a-random-32plus-char-secret
JWT__ISSUER=ECommerce.Api
JWT__AUDIENCE=ECommerce.Clients
JWT__EXPIRATIONMINUTES=120
JWT__REFRESHTOKENEXPIRATIONDAYS=30

# ---- Stripe (optional — leave empty until checkout is needed in the container) ----
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__PublishableKey=

# ---- SMTP (optional — empty Smtp__Host falls back to the no-op logging email sender) ----
# All three of Host, Username and Password must be set for real email delivery.
Smtp__Host=
Smtp__Port=587
Smtp__FromEmail=
Smtp__Username=
Smtp__Password=
