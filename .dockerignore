# Git/VCS
.git/
.gitignore

# Environment variables (contain SA password, JWT secret, SMTP creds)
.env
.env.local
.env.*.local

# Build output & intermediate files
**/bin/
**/obj/
publish/
artifacts/
TestResults/

# IDE & tooling
.vs/
.idea/
.vscode/
.opencode/
*.user
*.suo

# Scripts and docs not needed in build context
scripts/
README.md

# Everything the multi-stage Dockerfile doesn't need — it restores
