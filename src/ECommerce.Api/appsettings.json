{
  "Jwt": {
    "Issuer": "ECommerce.Api",
    "Audience": "ECommerce.Clients",
    "SecretKey": "",
    "ExpirationMinutes": 120,
    "RefreshTokenExpirationDays": 30
  },
  "Smtp": {
    "FromName": "ECommerce",
    "EnableSsl": true
  },
  "CachedAggregate":{
    "Basket": {
      "AbsoluteExpirationDays": 30,
      "SlidingExpirationDays": 7,
      "LocalCacheExpirationMinutes": 5,
      "SlidingRefreshMinutes": 30
    }
  },
  "Outbox": {
    "PollIntervalSeconds": 10,
    "BatchSize": 50,
    "MaxAttempts": 5
  },
  "Inbox": {
    "RetentionDays": 30,
    "CleanupIntervalMinutes": 60
  },
  "OrderExpiry": {
    "PendingExpirationHours": 24,
    "ScanIntervalMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
