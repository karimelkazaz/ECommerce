{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ECommerceDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "CachedAggregate":{
    "Basket": {
      "AbsoluteExpirationDays": 30,
      "SlidingExpirationDays": 7,
      "LocalCacheExpirationMinutes": 5,
      "SlidingRefreshMinutes": 30
    }
  },
  "Outbox": {
    "PollIntervalSeconds": 10,
    "BatchSize": 50,
    "MaxAttempts": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
